# Medha gateway — Podman Quadlet (rootless)
# Installed by setup-podman.sh into medha's ~/.config/containers/systemd/
# {{MEDHA_HOME}} is replaced at install time.

[Unit]
Description=Medha gateway (rootless Podman)

[Container]
Image=medha:local
ContainerName=medha
UserNS=keep-id
Volume={{MEDHA_HOME}}/.medha:/home/node/.medha
EnvironmentFile={{MEDHA_HOME}}/.medha/.env
Environment=HOME=/home/node
Environment=TERM=xterm-256color
PublishPort=18789:18789
PublishPort=18790:18790
Pull=never
Exec=node dist/index.js gateway --bind lan --port 18789

[Service]
TimeoutStartSec=300
Restart=on-failure

[Install]
WantedBy=default.target
